[Unit]
Description=Forensicator Enterprise — background workers (reports, enrichment, SIEM export)
After=forensicator-firstboot.service network.target
Requires=forensicator-firstboot.service

[Service]
Type=simple
User={{SERVICE_USER}}
WorkingDirectory={{APP_DIR}}
EnvironmentFile=/etc/forensicator/forensicator.env
ExecStart={{APP_DIR}}/node_modules/.bin/tsx {{APP_DIR}}/src/lib/jobs/worker.ts
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
