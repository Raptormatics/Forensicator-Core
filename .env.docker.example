# Forensicator Core — Docker Compose configuration.
# Copy to .env and fill in before `docker compose up -d`.
#
# Unlike deploy/provision.sh's bare-metal flow, Postgres/Redis are
# containers docker-compose.yml manages itself — you don't need
# DATABASE_URL or REDIS_HOST here, those are already wired to the
# postgres/redis services in docker-compose.yml directly.

# Required — session signing key. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Externally reachable URL — change this if you're not just browsing to
# http://localhost:3000 from the same machine (e.g. another machine on
# your LAN, or a reverse proxy in front of this).
PUBLIC_URL=http://localhost:3000

# Port docker-compose publishes on the host. Change if 3000 is taken.
APP_PORT=3000

# Name/slug for the single organization seeded on first boot.
ORG_NAME=Default Organization
ORG_SLUG=default

# Postgres password for the container — change this from the default if
# this will be reachable from anywhere other than your own machine.
POSTGRES_PASSWORD=forensicator

# Key used to encrypt secrets at rest (e.g. a configured AI provider's
# API key, Settings -> AI Analysis). Falls back to NEXTAUTH_SECRET if
# unset — set a dedicated value in production rather than reusing it.
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Unset by default — "Check for Updates" (Platform -> Updates) simply
# shows "not configured" with no network calls made. The Docker image
# doesn't self-update the way a bare-metal install does (there's no
# systemd service or sudoers rule to replace itself with a new release;
# you'd instead pull a new image/rebuild), so leaving this unset here is
# usually the right call unless you've built your own update tooling
# around this image.
UPDATE_SERVER_URL=
