DATABASE_URL="postgresql://forensicator:forensicator@localhost:5432/forensicator?schema=public&sslmode=disable"
UPLOAD_DEFAULT_USER_EMAIL="analyst@forensicator.local"

# Forensicator Core always runs in appliance mode — single organization,
# seeded on first boot. (Multi-tenant "saas" mode, with multiple
# organizations and a platform_admin role, is an Enterprise-only
# capability — see the Enterprise overlay, not this repo.)
DEPLOYMENT_MODE="appliance"
NEXT_PUBLIC_DEPLOYMENT_MODE="appliance"

# Name/slug for the single organization seeded on first boot.
ORG_NAME="Default Organization"
ORG_SLUG="default"

# Key used to encrypt secrets at rest (e.g. a configured AI provider's API
# key, Settings → AI Analysis). Falls back to NEXTAUTH_SECRET if unset —
# set a dedicated value in production (e.g. `openssl rand -base64 32`)
# rather than reusing it.
# ENCRYPTION_KEY="change-me-use-openssl-rand-base64-32"

# Unset by default — "Check for Updates" (Platform → Updates) simply stays
# off with no network calls made. Set this to enable it; offline/CLI
# installs of a signed .fpk package work either way, with or without this.
UPDATE_SERVER_URL="https://updates.forensicator.io/core"
