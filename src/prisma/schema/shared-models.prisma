// Forensicator Core — the 5 models the Enterprise overlay must REPLACE
// wholesale (not just add files alongside) to unlock Pro features, because
// they carry relation fields and/or columns the Pro feature set needs added
// to the SAME model Core already defines. Prisma doesn't support splitting
// one model's fields/relations across multiple schema files, so this file
// is the one place in the schema split where "additive overlay" doesn't
// apply — the overlay's version of this exact file (same path) replaces
// it outright. Keep this file's own fields/relations identical to what the
// overlay's version keeps for the Core-only parts, so a diff between the
// two stays limited to genuinely-new Pro additions.
//
// One of those genuine differences: User has no `role` column here at all.
// RBAC — multi-user creation and every role-based permission check — is an
// Enterprise-only capability, and Core is permanently single-user (the one
// account created at setup), so there's no role concept to store. The
// overlay's version of this file restores `role` on User (and
// core.prisma's OrganizationMember.role, the second role axis — see that
// file's own header comment, which is why it's now also a wholesale-replace
// file in the overlay despite carrying many Core-only models unrelated to
// this).

model User {
  id                     String          @id @default(uuid()) @db.Uuid
  email                  String          @unique
  name                   String?
  firstName              String?         @map("first_name")
  lastName               String?         @map("last_name")
  passwordHash           String?         @map("password_hash")
  isActive               Boolean         @default(true) @map("is_active")
  lastLogin              DateTime?       @map("last_login")
  failedLoginAttempts    Int             @default(0) @map("failed_login_attempts")
  lockedUntil            DateTime?       @map("locked_until")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  investigations         Investigation[] @relation("uploadedBy")
  assignedInvestigations Investigation[] @relation("assignedTo")
  assignedFindings       Finding[]       @relation("findingAssignee")
  reports                Report[]
  notes                  Note[]
  bookmarks              Bookmark[]
  activityLogs           ActivityLog[]
  createdCases           Case[]          @relation("caseCreatedBy")
  assignedCases          Case[]          @relation("caseAssignee")
  caseNotes              CaseNote[]      @relation("caseNoteAuthor")
  caseTasksOwned         CaseTask[]      @relation("caseTaskOwner")
  caseTasksCreated       CaseTask[]      @relation("caseTaskCreatedBy")
  orgMemberships         OrganizationMember[]
  apiKeys                ApiKey[]
  auditLogs              AuditLog[]
  hostIsolationUpdates   HostProfile[]
  logUploads             LogUpload[]
  logAnalysisRules       LogAnalysisRule[]      @relation("logRuleAuthor")
  logDecoders            LogDecoder[]           @relation("logDecoderAuthor")
  correlationWhitelist   CorrelationWhitelist[]
  iocBlocklistUpdates    IocRecord[]
  pcapUploads            PcapUpload[]
  pcapAnalysisRules      PcapAnalysisRule[]     @relation("pcapRuleAuthor")
  pcapYaraRules          PcapYaraRule[]         @relation("pcapYaraRuleAuthor")
  ramUploads             RamUpload[]
  ramUploadSessions      RamUploadSession[]
  ramAnalysisRules       RamAnalysisRule[]      @relation("ramRuleAuthor")
  ramYaraRules           RamYaraRule[]          @relation("ramYaraRuleAuthor")
  ramSymbolTables        RamSymbolTable[]
  windowsArtifactUploads WindowsArtifactUpload[]
  windowsArtifactRules   WindowsArtifactRule[]  @relation("winArtifactRuleAuthor")
  importedIocs           ImportedIoc[]
  caseKnownHashes        CaseKnownHash[]

  @@map("users")
}

model Investigation {
  id                    String    @id @default(uuid()) @db.Uuid
  title                 String
  description           String?
  hostname              String?
  status                String    @default("uploaded")
  metadata              Json      @default("{}")
  aiStatus              String    @default("not_queued") @map("ai_status")
  aiSummary             String?   @map("ai_summary") @db.Text
  aiConfidence          Float?    @map("ai_confidence")
  findingCount          Int       @default(0) @map("finding_count")
  uploadedById          String    @map("uploaded_by_id") @db.Uuid
  uploadedBy            User      @relation("uploadedBy", fields: [uploadedById], references: [id])
  assigneeId            String?   @map("assignee_id") @db.Uuid
  assignee              User?     @relation("assignedTo", fields: [assigneeId], references: [id])
  findings              Finding[]
  evidence              Evidence[]
  timelineEvents        TimelineEvent[]
  reports               Report[]
  notes                 Note[]
  bookmarks              Bookmark[]
  activityLogs          ActivityLog[]
  attackPaths           AttackPath[]

  // Each investigation belongs to at most one case (nullable only for
  // legacy pre-Case investigations); enforced at the API layer too.
  caseId                String?   @map("case_id") @db.Uuid
  case                  Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)

  organizationId        String?   @map("organization_id") @db.Uuid
  organization          Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // ── Metadata-derived enrichment fields ──────────────────────────────────
  investigationSourceId String?   @map("investigation_source_id")
  username              String?
  osInfo                Json?     @map("os_info") @db.JsonB
  tags                  String[]  @default([])
  detectionStats        Json?     @map("detection_stats") @db.JsonB
  archiveSha256         String?   @map("archive_sha256")
  // ────────────────────────────────────────────────────────────────────────

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([uploadedById])
  @@index([assigneeId])
  @@index([hostname])
  @@index([status])
  @@index([organizationId])
  @@index([createdAt])
  @@index([archiveSha256])
  @@index([caseId])
  @@map("investigations")
}

model Case {
  id          String   @id @default(uuid()) @db.Uuid
  caseSeq     Int      @unique @default(autoincrement()) @map("case_seq")
  title       String
  description String?  @db.Text
  status      String   @default("open")   // open | active | monitoring | resolved | closed
  severity    String   @default("medium") // critical | high | medium | low
  incidentType String? @map("incident_type") // matches Playbook.incidentType when a playbook's been applied
  tags        String[] @default([])

  createdById String   @map("created_by_id") @db.Uuid
  createdBy   User     @relation("caseCreatedBy", fields: [createdById], references: [id])
  assigneeId  String?  @map("assignee_id") @db.Uuid
  assignee    User?    @relation("caseAssignee", fields: [assigneeId], references: [id])

  investigations     Investigation[]
  notes              CaseNote[]
  reports            Report[]
  tasks              CaseTask[]
  correlations       Correlation[]
  logUploads         LogUpload[]
  pcapUploads        PcapUpload[]
  ramUploads         RamUpload[]
  ramUploadSessions  RamUploadSession[]
  windowsArtifactUploads WindowsArtifactUpload[]
  importedIocs       ImportedIoc[]
  caseKnownHashes    CaseKnownHash[]

  organizationId String?  @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdById])
  @@index([assigneeId])
  @@index([organizationId])
  @@index([createdAt])
  @@map("cases")
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique  // URL-safe identifier
  description String?  @db.Text
  logoUrl     String?  @map("logo_url")
  website     String?
  plan        String   @default("free")  // free | enterprise
  settings    Json     @default("{}") @db.JsonB  // branding, notifications, etc.

  // Quotas
  maxUsers           Int @default(10)    @map("max_users")
  maxInvestigations  Int @default(100)   @map("max_investigations")
  maxStorageGb       Int @default(10)    @map("max_storage_gb")

  members        OrganizationMember[]
  investigations Investigation[]
  cases          Case[]
  hostProfiles   HostProfile[]
  apiKeys        ApiKey[]
  auditLogs      AuditLog[]
  logUploads     LogUpload[]
  logAnalysisRules LogAnalysisRule[]
  logDecoders    LogDecoder[]
  threatIntelProviders OrgThreatIntelProvider[]
  correlationWhitelist CorrelationWhitelist[]
  pcapUploads    PcapUpload[]
  pcapAnalysisRules PcapAnalysisRule[]
  pcapYaraRules  PcapYaraRule[]
  ramUploads     RamUpload[]
  ramUploadSessions RamUploadSession[]
  ramAnalysisRules RamAnalysisRule[]
  ramYaraRules   RamYaraRule[]
  ramSymbolTables RamSymbolTable[]
  windowsArtifactUploads WindowsArtifactUpload[]
  windowsArtifactRules   WindowsArtifactRule[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([plan])
  @@map("organizations")
}

model SystemSettings {
  id String @id @default("singleton")

  // The instance's own canonical public URL, e.g. https://forensicator.tesco.com
  // or http://tescoserver.local — set once DNS/a hostname points at this
  // instance's IP. Used to show a real, stable base URL in the API docs
  // instead of guessing from whatever address a given visitor happens to
  // be browsing from. Null means "not configured" — callers fall back to
  // the request's own origin.
  appDomain String? @map("app_domain")

  // Overrides REPORTS_DIR when set — read fresh per report job, so unlike
  // Redis this is safe to change without a restart.
  reportsDir String? @map("reports_dir")

  // Forensicator AI — analyst-assist finding analysis. Read fresh per job
  // (like reportsDir), so all of this is changeable without a restart. Off
  // by default: no LLM binary or model is bundled with the app (a local
  // model alone can be several GB) — enabling this from Settings > AI
  // Analysis is what actually installs/points at one, post-deployment.
  aiEnabled  Boolean @default(false) @map("ai_enabled")
  aiProvider String  @default("ollama") @map("ai_provider")
  aiHost     String  @default("http://localhost:11434") @map("ai_host")
  aiModel    String  @default("mistral:7b-instruct") @map("ai_model")
  aiApiKeyEncrypted String? @map("ai_api_key_encrypted") @db.Text
  aiApiKeyLast4     String? @map("ai_api_key_last4")
  // true = Forensicator installs and manages a local Ollama systemd service
  // on THIS host (see deploy/forensicator-ollama-ctl.sh) — only meaningful
  // when aiProvider="ollama".
  ollamaManaged Boolean @default(false) @map("ollama_managed")

  // Overrides PCAP_DIR when set — same read-fresh-per-job, no-restart-needed
  // pattern as reportsDir. Raw uploaded .pcap/.pcapng bytes are kept on disk
  // here (unlike investigation/log uploads, PCAP analysis re-reads the file
  // via tshark rather than fully dissolving it into DB rows on first parse).
  pcapDir String? @map("pcap_dir")
  // Path/name of the tshark binary the PCAP worker invokes. Null resolves to
  // TSHARK_PATH env var, then bare "tshark" (resolved via PATH). No install/
  // start/stop lifecycle to manage here — tshark is a stateless CLI reading
  // a file, not a service.
  tsharkPath String? @map("tshark_path")

  // Overrides RAM_DIR when set — same read-fresh-per-job, no-restart-needed
  // pattern as pcapDir. Raw uploaded memory-image bytes are kept on disk here
  // (RAM Analysis re-reads the file via Volatility3 per plugin rather than
  // dissolving it into DB rows on first parse).
  ramDir String? @map("ram_dir")
  // Absolute path to the `vol` binary the RAM worker invokes. Null resolves
  // to VOLATILITY_PATH env var, then <APP_DIR>/.venvs/volatility3/bin/vol —
  // unlike tsharkPath's bare "tshark", Volatility3 lives inside an isolated
  // Python venv (see deploy/provision.sh), never on PATH.
  volatilityPath String? @map("volatility_path")
  // Optional local symbol-table cache directory passed to Volatility3 via
  // -s/--symbol-dirs. Null means Volatility3 falls back to its own bundled
  // cache and, for unseen Windows builds, fetching from the public symbol
  // server over the network. Pre-staging this speeds up repeat analysis and
  // helps air-gapped deployments.
  volatilitySymbolsDir String? @map("volatility_symbols_dir")

  // Overrides RAM_CHUNK_SIZE_BYTES when set — chunked RAM uploads (see
  // RamUploadSession) split the source file into pieces no larger than
  // this so any request individually stays under a fronting reverse
  // proxy/tunnel's own body-size cap (e.g. Cloudflare's, which is enforced
  // at its edge and can't be raised via any origin-server config). Null
  // resolves to the env var, then a 40MB default — safely under even
  // Cloudflare's most restrictive (Free/Pro, 100MB) tier.
  ramChunkSizeBytes Int? @map("ram_chunk_size_bytes")

  // Overrides WIN_ARTIFACTS_DIR when set — same read-fresh-per-job,
  // no-restart-needed pattern as pcapDir/ramDir. Raw uploaded registry
  // hives/Prefetch/LNK files are kept on disk here.
  winArtifactsDir String? @map("win_artifacts_dir")
  // Absolute path to the Windows Artifact Analysis venv's python3. Null
  // resolves to WIN_ARTIFACTS_PYTHON_PATH env var, then
  // <APP_DIR>/.venvs/winartifacts/bin/python3 — its own venv, not shared
  // with Volatility3's (see deploy/provision.sh).
  winArtifactsPythonPath String? @map("win_artifacts_python_path")
  // Path to the system python3 that has python3-libscca (pyscca) installed
  // — Prefetch parsing uses the apt-installed libscca bindings, not the
  // winartifacts venv (see getPrefetchPythonPath()'s own doc comment).
  prefetchPythonPath String? @map("prefetch_python_path")
  // Path to the system python3 that has pyfsntfs ($MFT) and pyesedb
  // (SRUDB.dat) installed — same reasoning as prefetchPythonPath above
  // (C-linked libyal bindings, not the winartifacts venv); shared by both
  // since they're installed together by the same deploy step and have
  // identical requirements, unlike Prefetch's separate dedicated setting.
  winArtifactsSystemPythonPath String? @map("win_artifacts_system_python_path")
  // Path to a SEPARATE venv's python3 with bits_parser installed — kept
  // apart from winArtifactsPythonPath because bits_parser hard-pins
  // construct==2.8.12 while regipy needs construct>=2.10 for an API
  // added in that version; the two packages can never coexist in one
  // venv. See getWinArtifactsBitsPythonPath()'s own comment for the
  // full story and deploy/install-winartifacts-deps.sh for the venv
  // this defaults to.
  winArtifactsBitsPythonPath String? @map("win_artifacts_bits_python_path")
  // Overrides WIN_ARTIFACTS_MAX_UPLOAD_BYTES when set — the combined size
  // cap for one Windows Artifact Analysis upload (registry hives + their
  // .LOG1/.LOG2, $MFT, Prefetch, WER dumps, etc. all add up — a busy
  // workstation's $MFT alone can run 1-2+ GB). BigInt, not Int — a 5GB+
  // default/value overflows Postgres's 32-bit int4. Null resolves to the
  // env var, then a 5GB default. Enforced identically client-side (the
  // upload page) and server-side (the uploads route) — see
  // getWinArtifactsMaxUploadBytes().
  winArtifactsMaxUploadBytes BigInt? @map("win_artifacts_max_upload_bytes")

  // Critical-finding email alerts — one channel, one recipient address.
  // Off by default (no SMTP server is assumed to exist). Read fresh per
  // processing run, same no-restart-needed convention as the settings
  // above. criticalFindingAlertsEnabled gates sending; the SMTP fields
  // below configure how, and notificationEmail configures who.
  criticalFindingAlertsEnabled Boolean @default(false) @map("critical_finding_alerts_enabled")
  notificationEmail            String? @map("notification_email")
  smtpHost                     String? @map("smtp_host")
  smtpPort                     Int?    @map("smtp_port")
  smtpUser                     String? @map("smtp_user")
  smtpPasswordEncrypted        String? @map("smtp_password_encrypted") @db.Text
  smtpPasswordLast4            String? @map("smtp_password_last4")
  smtpFromAddress              String? @map("smtp_from_address")
  smtpSecure                   Boolean @default(false) @map("smtp_secure")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
