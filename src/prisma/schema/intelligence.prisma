// IOC management, correlation, and threat intel — ported from the
// Enterprise overlay into Core. These used to be overlay-only; Core's
// upload pipeline already had dynamic-import hooks for them (see
// src/app/api/investigations/upload/route.ts) that silently no-op'd when
// the modules weren't present. Now native.

model IocRecord {
  id              String        @id @default(uuid()) @db.Uuid
  value           String        @unique // the raw IOC (IP, hash, URL, domain)
  type            String        // ip | hash | url | domain | email
  firstSeen       DateTime?     @map("first_seen")
  lastSeen        DateTime?     @map("last_seen")
  reputation      Int?          // 0-100 maliciousness score
  confidence      Int?          // 0-100
  malwareFamily   String?       @map("malware_family")
  threatType      String?       @map("threat_type")
  enrichedAt      DateTime?     @map("enriched_at")
  enrichJobId     String?       @map("enrich_job_id")
  providerResults Json?         @map("provider_results") @db.JsonB

  // Analyst-tracked blocklist recommendation — this platform has no
  // firewall/proxy/EDR integration to actually enforce a block, so this
  // only records "this should be blocked at the perimeter," the same
  // manual-tracking convention as HostProfile.isolationStatus.
  blocklisted        Boolean   @default(false)
  blocklistedAt      DateTime? @map("blocklisted_at")
  blocklistedById    String?   @map("blocklisted_by_id") @db.Uuid
  blocklistedBy      User?     @relation(fields: [blocklistedById], references: [id], onDelete: SetNull)

  enrichments     IocEnrichment[]

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([type])
  @@index([reputation])
  @@index([enrichedAt])
  @@index([blocklisted])
  @@map("ioc_records")
}

model IocEnrichment {
  id          String    @id @default(uuid()) @db.Uuid
  iocId       String    @map("ioc_id") @db.Uuid
  ioc         IocRecord @relation(fields: [iocId], references: [id], onDelete: Cascade)
  provider    String    // virustotal | abuseipdb | urlhaus | otx | threatfox | malwarebazaar
  status      String    @default("pending")  // pending | ok | error | not_found
  response    Json?     @db.JsonB
  enrichedAt  DateTime? @map("enriched_at")
  errorMsg    String?   @map("error_msg") @db.Text

  @@unique([iocId, provider])
  @@index([iocId])
  @@index([provider, status])
  @@map("ioc_enrichments")
}

model Correlation {
  id              String   @id @default(uuid()) @db.Uuid
  caseId          String?  @map("case_id") @db.Uuid
  case            Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  correlationType String   @map("correlation_type") // hash | user | ip | domain | url | process | persistence
  value           String   // the shared value (hash, username, etc.)
  confidence      Int      @default(50) // 0-100
  hosts           String[] // list of hostnames involved
  investigationIds String[] @map("investigation_ids")  // DB UUIDs
  evidenceIds     String[] @map("evidence_ids")
  metadata        Json?    @db.JsonB
  jobId           String?  @map("job_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([caseId])
  @@index([correlationType])
  @@index([confidence])
  @@index([createdAt])
  @@map("correlations")
}

model CorrelationWhitelist {
  id              String   @id @default(uuid()) @db.Uuid
  correlationType String   @map("correlation_type")
  value           String
  note            String?  @db.Text

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id])

  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([correlationType, value, organizationId])
  @@index([correlationType, value])
  @@map("correlation_whitelist")
}

model OrgThreatIntelProvider {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  provider        String       // virustotal | abuseipdb | otx | urlhaus | threatfox | malwarebazaar
  encryptedApiKey String?      @map("encrypted_api_key") @db.Text // null for keyless providers
  keyLast4        String?      @map("key_last4") // last 4 chars, plaintext, for display only
  enabled         Boolean      @default(true)

  lastUsedAt      DateTime?    @map("last_used_at")
  lastError       String?      @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, provider])
  @@index([organizationId])
  @@map("org_threat_intel_providers")
}

model UrlhausFeedEntry {
  id          String    @id @default(uuid()) @db.Uuid
  urlhausId   String    @unique @map("urlhaus_id") // the feed's own numeric id
  url         String    @db.Text
  urlStatus   String?   @map("url_status")
  threat      String?
  tags        String[]  @default([])
  reporter    String?
  dateAdded   DateTime? @map("date_added")
  urlhausLink String?   @map("urlhaus_link")
  syncedAt    DateTime  @default(now()) @map("synced_at")

  // Some URLs exceed the btree row-size limit (same issue Evidence.url hit) —
  // hash index only supports equality, which is all this is ever queried with.
  @@index([url], type: Hash)
  @@map("urlhaus_feed_entries")
}

// Local cache of MalwareBazaar's free, keyless csv_recent bulk feed — same
// role as UrlhausFeedEntry, just for hashes instead of URLs (see
// src/lib/intelligence/malwarebazaar-feed.ts). A sample can be matched by
// any of its three hash columns, since IocRecord's hash-type values are
// algorithm-agnostic.
model MalwareBazaarFeedEntry {
  id        String    @id @default(uuid()) @db.Uuid
  sha256    String    @unique
  md5       String?
  sha1      String?
  fileName  String?   @map("file_name")
  fileType  String?   @map("file_type")
  signature String?
  reporter  String?
  firstSeen DateTime? @map("first_seen")
  syncedAt  DateTime  @default(now()) @map("synced_at")

  @@index([md5])
  @@index([sha1])
  @@map("malwarebazaar_feed_entries")
}

// The fifth IOC source pipeline (see src/lib/ioc/scope.ts's own header
// comment) — links a manually-imported value (POST /api/ioc/import) to the
// case it was imported into. IocRecord itself stays global/deduplicated
// (so enrichment is never wasted re-querying a value already known from
// another case); this table only scopes *visibility* of a manual import,
// the same role Evidence/LogIoc/PcapIoc/RamIoc already play for their own
// pipelines.
model ImportedIoc {
  id          String   @id @default(uuid()) @db.Uuid
  caseId      String   @map("case_id") @db.Uuid
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  value       String
  type        String   // ip | hash | url | domain
  createdById String   @map("created_by_id") @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([caseId, value])
  @@index([caseId])
  @@map("imported_iocs")
}

// Known-good file hash allowlisting (NSRL-style) — Evidence.hash is a
// single untyped field (no separate md5/sha1/sha256 columns, see
// core.prisma's Evidence model), so matching is plain string equality
// regardless of algorithm. Same global-dedup + case-scoped-visibility
// split as IocRecord/ImportedIoc above: KnownHash is deduplicated across
// every case (so importing the same NSRL set twice never doubles storage),
// CaseKnownHash scopes which case actually treats a hash as known-good.
model KnownHash {
  id        String   @id @default(uuid()) @db.Uuid
  hash      String   @unique
  source    String   @default("custom") // nsrl | custom
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  cases     CaseKnownHash[]

  @@index([source])
  @@map("known_hashes")
}

model CaseKnownHash {
  id          String    @id @default(uuid()) @db.Uuid
  caseId      String    @map("case_id") @db.Uuid
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  knownHashId String    @map("known_hash_id") @db.Uuid
  knownHash   KnownHash @relation(fields: [knownHashId], references: [id], onDelete: Cascade)
  createdById String    @map("created_by_id") @db.Uuid
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([caseId, knownHashId])
  @@index([caseId])
  @@map("case_known_hashes")
}
