// Windows Artifact Analysis — execution/persistence/access evidence parsed
// from raw Windows forensic artifacts (registry hives, Prefetch, LNK/Jump
// Lists/Shellbags). One upload is a "collection" of files gathered from a
// single host in one triage pass (SYSTEM/SOFTWARE/NTUSER.DAT×N/Amcache.hve
// today; Prefetch/LNK/JumpList files join the same collection in later
// phases) — mirrors RamUpload/PcapUpload's shape, but with each file
// processed and tracked independently (WindowsArtifactFile) rather than
// the collection itself owning a single storagePath/status, since a
// collection can contain many files of different types that succeed or
// fail to parse independently.

model WindowsArtifactUpload {
  id       String  @id @default(uuid()) @db.Uuid
  hostname String?
  notes    String? @db.Text

  findingCount Int @default(0) @map("finding_count")

  uploadedById   String        @map("uploaded_by_id") @db.Uuid
  uploadedBy     User          @relation(fields: [uploadedById], references: [id])
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  caseId String? @map("case_id") @db.Uuid
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)

  files WindowsArtifactFile[]

  // GUID -> DllName, extracted from a software_hive file's
  // SRUM\Extensions registry key (see registry-parse.py's srum_extension
  // emission) when one is processed in this same collection. Upload-level,
  // not per-file, since it's shared context a srum_db file's own
  // processing cross-checks against — order-independent either way (see
  // srum-engine.ts): whichever of the two files finishes first just
  // leaves this null until the other one sets it.
  srumExtensionsMap Json? @db.JsonB @map("srum_extensions_map")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([uploadedById])
  @@index([organizationId])
  @@index([caseId])
  @@index([createdAt])
  @@map("windows_artifact_uploads")
}

// One uploaded file within a collection — own status lifecycle, own
// storagePath, processed by its own BullMQ job so one bad hive doesn't
// block the rest of the collection. `role` drives which parser the job
// dispatcher routes to (src/lib/windows-artifacts/processor.ts).
model WindowsArtifactFile {
  id       String @id @default(uuid()) @db.Uuid
  uploadId String @map("upload_id") @db.Uuid
  upload   WindowsArtifactUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  // system_hive | software_hive | security_hive | ntuser_hive | amcache_hive | usrclass_hive
  // | prefetch | lnk | jumplist_automatic | jumplist_custom | mft | usnjrnl | srum_db
  // | wer_report | wer_dump | recycle_bin | notification_db | search_edb | quarantine_entry
  // | quarantine_resource | bits_queue | timeline_db
  role     String
  filename String
  fileSize Int    @map("file_size")
  sha256   String

  status       String  @default("queued") // queued | processing | ready | failed
  storagePath  String? @map("storage_path")
  jobId        String? @map("job_id")
  errorMessage String? @map("error_message") @db.Text

  findingCount Int @default(0) @map("finding_count")

  // Which user profile this file belongs to, for ntuser_hive/usrclass_hive
  // roles with more than one per collection — derived from the folder name
  // the analyst's collector preserved (e.g. "Users\jsmith\NTUSER.DAT"), set
  // at upload time from the form field label, not parsed from the hive
  // itself (SAM-based SID-to-username mapping is real but out of scope here).
  profileName String? @map("profile_name")

  // Raw fsutil usn queryjournal output for a "usnjrnl"-role file, when
  // the collector gathered it alongside the raw $J stream — volume-level
  // context (journal ID, USN range, max size), not a per-record field, so
  // it lives here rather than on UsnJrnlEntry.
  journalMetadataText String? @map("journal_metadata_text") @db.Text

  // For registry-hive roles only: this hive's own <HIVE>.LOG1/.LOG2
  // transaction log companions, when the collector gathered them —
  // regipy's apply_transaction_logs() replays their "dirty page"
  // transactions into a recovered hive before parsing, for a more
  // complete/accurate result. Not a per-record artifact of its own
  // (unlike journalMetadataText's analogue above, these ARE themselves
  // files that must round-trip through disk to reach the Python
  // subprocess), so they get their own storagePath-style columns here
  // rather than an inline text field.
  log1StoragePath String? @map("log1_storage_path")
  log2StoragePath String? @map("log2_storage_path")

  shimcacheEntries  ShimcacheEntry[]
  amcacheEntries    AmcacheEntry[]
  userAssistEntries UserAssistEntry[]
  bamEntries        BamEntry[]
  autorunEntries    AutorunEntry[]
  prefetchEntries   PrefetchEntry[]
  lnkEntries        LnkEntry[]
  jumpListEntries   JumpListEntry[]
  shellbagEntries   ShellbagEntry[]
  mftEntries        MftEntry[]
  usnJrnlEntries    UsnJrnlEntry[]
  srumEntries       SrumEntry[]
  werReportEntries  WerReportEntry[]
  werDumpEntries    WerDumpEntry[]
  recycleBinEntries RecycleBinEntry[]
  notificationEntries NotificationEntry[]
  searchIndexEntries  SearchIndexEntry[]
  quarantineEntries   DefenderQuarantineEntry[]
  quarantinePayloads  DefenderQuarantinePayload[]
  bitsJobEntries      BitsJobEntry[]
  timelineEntries     TimelineActivityEntry[]
  findings          WindowsArtifactFinding[]

  createdAt DateTime  @default(now()) @map("created_at")
  parsedAt  DateTime? @map("parsed_at")

  @@index([uploadId])
  @@index([role])
  @@index([status])
  @@map("windows_artifact_files")
}

model ShimcacheEntry {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  path          String   @db.Text
  lastModified  DateTime? @map("last_modified") // the cached file's own mtime at the time it was cached, not execution time
  executionFlag Boolean? @map("execution_flag") // true/false/null — null on OS versions where AppCompatCache doesn't carry an execute bit (Win10+)
  order         Int      // position within the cache (most-recent-first ordering as stored)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@index([path])
  @@map("shimcache_entries")
}

model AmcacheEntry {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  path          String    @db.Text
  sha1          String?   // leading "0000" prefix (an Amcache storage quirk) stripped at parse time
  fileSizeBytes BigInt?   @map("file_size_bytes")
  publisher     String?
  firstSeen     DateTime? @map("first_seen") // InventoryApplicationFile's own first-seen/install timestamp

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@index([sha1])
  @@index([path])
  @@map("amcache_entries")
}

model UserAssistEntry {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  programPath  String    @map("program_path") @db.Text // ROT13-decoded value name
  runCount     Int?      @map("run_count")
  lastExecuted DateTime? @map("last_executed")
  focusCount   Int?      @map("focus_count") // Vista+ blob only; null on XP-format entries
  focusTimeMs  Int?      @map("focus_time_ms")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@index([programPath])
  @@map("userassist_entries")
}

model BamEntry {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  sid          String // the user SID this execution entry is filed under (ControlSet\Services\bam\State\UserSettings\{SID})
  path         String    @db.Text
  lastExecuted DateTime? @map("last_executed")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@index([path])
  @@map("bam_entries")
}

model AutorunEntry {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  hiveSource String @map("hive_source") // system | software | ntuser — which uploaded file this was read from
  keyPath    String @map("key_path") @db.Text
  valueName  String? @map("value_name")
  valueData  String @map("value_data") @db.Text

  // run | runonce | winlogon_shell | winlogon_userinit | appinit_dll | service
  category String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@index([category])
  @@map("autorun_entries")
}

// Phase 2 — one row per .pf file (one upload per executable; Prefetch has
// no concept of "per user profile" the way NTUSER.DAT does).
model PrefetchEntry {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  executableName  String     @map("executable_name") // bare exe name, e.g. "POWERSHELL.EXE" — Prefetch doesn't retain full invocation paths
  runCount        Int?       @map("run_count")
  lastRunTimes    DateTime[] @map("last_run_times") // up to 8 most-recent run timestamps on Vista+ format; just the one on XP format
  firstRunTime    DateTime?  @map("first_run_time")  // earliest of lastRunTimes, precomputed for easy sort/filter
  volumeSerials   String[]   @map("volume_serials")
  referencedFiles String[]   @map("referenced_files") // loaded DLLs + other files referenced during execution

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@index([executableName])
  @@map("prefetch_entries")
}

// Phase 3 — one row per standalone .lnk upload (role: "lnk") AND one row
// per embedded LNK inside a .customDestinations-ms (role: "jumplist_custom"
// — those have no DestList-equivalent index, just concatenated raw LNKs).
model LnkEntry {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  // Resolution priority: LinkInfo local base path + common path suffix ->
  // UNC net_name + common path suffix -> StringData relative_path ->
  // best-effort shell-item chain name. Mirrors MS-SHLLINK's own target
  // resolution precedence (LinkInfo first, when present).
  targetPath       String? @map("target_path") @db.Text
  arguments        String? @db.Text
  workingDirectory String? @map("working_directory") @db.Text
  iconLocation     String? @map("icon_location") @db.Text

  creationTime     DateTime? @map("creation_time")
  accessTime       DateTime? @map("access_time")
  modificationTime DateTime? @map("modification_time")
  fileSize         Int?      @map("file_size")

  driveSerialNumber String? @map("drive_serial_number") // LnkParse3 returns this as a "0x........" string, not an int
  driveType         String? @map("drive_type")
  volumeLabel       String? @map("volume_label")
  netName           String? @map("net_name") // UNC target only
  deviceName        String? @map("device_name") // UNC target only

  machineId String? @map("machine_id") // Distributed Link Tracker block's machine_identifier (NetBIOS name) — lateral-movement relevant

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@index([targetPath])
  @@map("lnk_entries")
}

// Phase 3 — one row per jump-list entry, covering BOTH jumplist_automatic
// (DestList-backed, richer metadata) and jumplist_custom (no DestList,
// metadata fields below just come back null) sources in one table — same
// conceptual artifact ("this app recently opened this file") either way.
model JumpListEntry {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  source String // automatic | custom

  // The AppID hash taken from the uploaded file's own filename (e.g.
  // "5f7b5f1e01b83767") — not resolved to a friendly app name; no attempt
  // at hand-maintaining the public AppID-to-app lookup table.
  appId            String? @map("app_id")
  targetPath       String? @map("target_path") @db.Text
  arguments        String? @db.Text
  workingDirectory String? @map("working_directory") @db.Text

  lastAccessed DateTime? @map("last_accessed")
  // Position within the DestList stream's own entry order, which is
  // itself MRU-ordered (confirmed against real sample data: position 0 is
  // the most-recently-used entry) — automatic only, null for custom.
  accessRank   Int?      @map("access_rank")
  pinned       Boolean?  @map("pinned") // DestList pin_status != -1 — automatic only
  machineName  String?   @map("machine_name") // automatic only
  streamNumber String?   @map("stream_number") // automatic only — cross-refs the raw OLE stream this came from

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@index([targetPath])
  @@map("jump_list_entries")
}

// Phase 3 — one row per BagMRU tree node (not just leaves — every node is
// itself a "this folder was accessed" artifact), decoded via regipy's own
// ntuser_shellbag_plugin/usrclass_shellbag_plugin (pyfwsi/pyfwps — libyal's
// authoritative shell-item bindings, pulled in via the `regipy[full]` pip
// extra), forwarded through the same plugin_entry mechanism as
// Shimcache/Amcache/BAM.
model ShellbagEntry {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  path     String @db.Text // full reconstructed path, accumulated root-to-node
  nodeName String @map("node_name") @db.Text // this node's own decoded shell-item name, before concatenation
  nodeSlot String @map("node_slot") // the registry subkey name at this level, e.g. "0", "3"
  depth    Int // derived from the reconstructed path's backslash count — a display proxy, not a literal registry-tree depth

  // The shell-item class name, e.g. "Directory" | "Network Location" |
  // "Root Folder" — distinguishes removable/network/local.
  itemType     String?   @map("item_type")
  creationTime DateTime? @map("creation_time") // from the shell item's extension block, when present
  accessTime   DateTime? @map("access_time")   // from the shell item's extension block, when present
  lastModified DateTime? @map("last_modified")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@index([path])
  @@map("shellbag_entries")
}

// $MFT — one row per NTFS Master File Table entry, parsed via pyfsntfs
// (libyal's libfsntfs Python bindings — same C-linked-library pattern as
// pyscca/Prefetch, see mft-parse.py). `path` is resolved via one
// in-memory parent-chain walk during parsing (entries reference parents
// by MFT entry number, which only resolves meaningfully within the same
// parse — not stored as a live FK to another MftEntry row). Real-world
// row counts run into the hundreds of thousands to low millions —
// deliberately NOT capped at ingestion (every row goes in, rules run
// against all of it); the results UI applies the same display cap every
// other artifact type already uses.
model MftEntry {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  mftEntryNumber    Int     @map("mft_entry_number")
  sequenceNumber    Int?    @map("sequence_number")
  name              String  @db.Text
  path              String? @db.Text // reconstructed via parent-chain walk; null if the chain couldn't be resolved (e.g. orphaned/truncated entry)
  parentEntryNumber Int?    @map("parent_entry_number")

  isAllocated Boolean @map("is_allocated") // false = a deleted entry still present in the table
  isDirectory Boolean @map("is_directory")

  // The four NTFS "MACB" timestamps — entryModificationTime (the MFT
  // record's own last-change time, distinct from the file's content
  // modificationTime) is specifically what timestomping-detection rules
  // compare creationTime against.
  creationTime         DateTime? @map("creation_time")
  modificationTime     DateTime? @map("modification_time")
  accessTime           DateTime? @map("access_time")
  entryModificationTime DateTime? @map("entry_modification_time")

  fileSize                BigInt?  @map("file_size")
  hasAlternateDataStreams Boolean  @default(false) @map("has_alternate_data_streams")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@index([mftEntryNumber])
  @@index([path])
  @@map("mft_entries")
}

// $UsnJrnl:$J — one row per decoded USN_RECORD_V2/V3 (the journal's
// actual content lives entirely in this alternate data stream — see
// usnjrnl-parse.py's own header comment for why no library was used:
// it's a stable, documented Microsoft structure, hand-parsed via struct).
// fileReferenceNumber/parentFileReferenceNumber are NOT resolved to an
// MftEntry row at ingestion time (that would be an O(n*m) join against a
// potentially-huge MftEntry table for every one of a potentially-huge
// number of journal records) — left as opaque stringified 64-bit
// references for a rule/UI-level cross-reference instead.
model UsnJrnlEntry {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  usn                       BigInt
  fileReferenceNumber       String? @map("file_reference_number")
  parentFileReferenceNumber String? @map("parent_file_reference_number")
  timestamp                 DateTime?
  reason                    String[] // decoded USN_REASON_* flag names, e.g. ["DATA_OVERWRITE", "CLOSE"]
  fileName                  String?  @map("file_name") @db.Text
  fileAttributes            Int?     @map("file_attributes")
  sourceInfo                Int?     @map("source_info")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@index([usn])
  @@index([fileName])
  @@map("usn_jrnl_entries")
}

// SRUDB.dat (SRUM/System Resource Usage Monitor) — one row per ESE record,
// read via pyesedb (libyal's libesedb Python bindings) across every table
// in the database. `tableName` is the raw GUID (or SruDbIdMapTable/
// SruDbCheckpointTable); `providerLabel` resolves it to a friendly name
// via a hardcoded table of the well-documented SRUM providers (the
// SRUM\Extensions registry key only gives a DLL path, not a human label —
// see srum-parse.py). `details` holds provider-specific columns (bytes
// sent/received for network usage, CPU/disk metrics for app resource
// usage, etc.) as a flexible JSON blob rather than forcing every
// provider's genuinely different schema into fixed typed columns — same
// precedent as WindowsArtifactRule.conditions.
model SrumEntry {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  tableName     String  @map("table_name")
  providerLabel String? @map("provider_label")
  timestamp     DateTime?
  appId         String? @map("app_id") @db.Text
  userSid       String? @map("user_sid")
  details       Json    @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@index([tableName])
  @@index([appId])
  @@map("srum_entries")
}

model WindowsArtifactFinding {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  ruleId String?             @map("rule_id") @db.Uuid
  rule   WindowsArtifactRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  title        String
  description  String?   @db.Text
  severity     String    // critical | high | medium | low | info
  matchCount   Int       @default(1) @map("match_count")
  firstSeen    DateTime? @map("first_seen")
  lastSeen     DateTime? @map("last_seen")
  matchedField String?   @map("matched_field")
  matchedValue String?   @map("matched_value") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@index([ruleId])
  @@index([severity])
  @@map("windows_artifact_findings")
}

model WindowsArtifactRule {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?  @db.Text
  severity    String   @default("medium") // critical | high | medium | low | info
  enabled     Boolean  @default(true)
  isBuiltin   Boolean  @default(false) @map("is_builtin")
  logic       String   @default("AND")    // AND | OR
  conditions  Json     @db.JsonB           // [{ id, field, operator, value }]
  tags        String[] @default([])

  createdById    String?       @map("created_by_id") @db.Uuid
  createdBy      User?         @relation("winArtifactRuleAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  hitCount Int @default(0) @map("hit_count")

  findings WindowsArtifactFinding[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([enabled])
  @@index([severity])
  @@index([isBuiltin])
  @@map("windows_artifact_rules")
}

// ─────────────────────────────────────────────────────────────────────────
// Windows Error Reporting — Report.wer (text key=value) and the associated
// minidump (.dmp), each uploaded independently via the collector's own
// per-report folder structure (WER\<System|profile>\ReportArchive|
// ReportQueue\<report-folder>\...) — see wer-engine.ts/wer-parse.py and
// wer-dump-engine.ts/wer-dump-parse.py.
// ─────────────────────────────────────────────────────────────────────────
model WerReportEntry {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  sourceFileName String @map("source_file_name") @db.Text // relative path preserved from the collector (e.g. "jsmith/ReportArchive/.../Report.wer")

  eventType String? @map("event_type") // e.g. APPCRASH, BEX, CLR20r3 — drives which Sig[n] slots mean what
  eventTime DateTime? @map("event_time")
  reportGuid String? @map("report_guid")

  // Microsoft's documented APPCRASH bucket parameters (Sig[0..7]) — only
  // meaningful when eventType is APPCRASH-shaped; left null otherwise.
  appName                String?   @map("app_name") @db.Text
  appVersion             String?   @map("app_version")
  appTimestamp           String?   @map("app_timestamp")
  faultModuleName        String?   @map("fault_module_name") @db.Text
  faultModuleVersion     String?   @map("fault_module_version")
  faultModuleTimestamp   String?   @map("fault_module_timestamp")
  exceptionCode          String?   @map("exception_code")
  exceptionOffset        String?   @map("exception_offset")

  sigFields Json @db.JsonB @map("sig_fields") // full Sig[n]/DynamicSig[n] Name/Value list, any eventType
  rawFields Json @db.JsonB @map("raw_fields") // every Key=Value line verbatim — nothing dropped

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@map("wer_report_entries")
}

model WerDumpEntry {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  sourceFileName String @map("source_file_name") @db.Text

  exceptionCode    String? @map("exception_code")
  exceptionAddress String? @map("exception_address")
  faultingThreadId Int?    @map("faulting_thread_id")

  processId         Int?      @map("process_id")
  processCreateTime DateTime? @map("process_create_time")

  osVersion       String? @map("os_version")
  cpuArchitecture String? @map("cpu_architecture")

  moduleList Json @db.JsonB @map("module_list") // [{name, baseAddress, size}] — loaded modules, feeds existing LOLBin/path rules via refKey per module
  miscInfo   Json @db.JsonB @map("misc_info")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@map("wer_dump_entries")
}

// ─────────────────────────────────────────────────────────────────────────
// Recycle Bin $I metadata files — see recyclebin-engine.ts/recyclebin-parse.py.
// ─────────────────────────────────────────────────────────────────────────
model RecycleBinEntry {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  sid            String @map("sid") // the $Recycle.Bin\<SID> folder this came from
  sourceFileName String @map("source_file_name") @db.Text // the $I filename itself
  formatVersion  Int    @map("format_version") // 1 (pre-Win10) or 2

  originalPath   String    @db.Text @map("original_path")
  deletedTime    DateTime? @map("deleted_time")
  fileSizeBytes  BigInt?   @map("file_size_bytes")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@index([sid])
  @@map("recycle_bin_entries")
}

// ─────────────────────────────────────────────────────────────────────────
// Windows notification platform database (wpndatabase.db/appdb.dat) — see
// notification-engine.ts/notification-parse.py. SQLite is self-describing,
// so this leans on live PRAGMA table_info() introspection rather than a
// hardcoded schema; `details` always carries the full row regardless of
// whether the well-known Notification/NotificationHandler columns matched.
// ─────────────────────────────────────────────────────────────────────────
model NotificationEntry {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  profileName String? @map("profile_name")

  arrivalTime DateTime? @map("arrival_time")
  expiryTime  DateTime? @map("expiry_time")
  notifType   String?   @map("notif_type")
  tag         String?
  groupName   String?   @map("group_name")
  handlerId   String?   @map("handler_id")
  handlerLabel String?  @map("handler_label") // resolved via the same file's NotificationHandler table, when present

  payload String? @db.Text // the notification's own XML/text payload, verbatim

  details Json @db.JsonB // the full row, every column this DB actually has

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@map("notification_entries")
}

// ─────────────────────────────────────────────────────────────────────────
// Windows Search database (Windows.edb) — see search-engine.ts/search-
// parse.py. Real-world column names are frequently per-install-specific/
// obfuscated on modern Windows, so this is a structural dump for manual
// review (table/column -> value), not a semantic decode — deliberately not
// fed into the rule engine (see windows-artifacts plan's Decisions).
// ─────────────────────────────────────────────────────────────────────────
model SearchIndexEntry {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  tableName   String @map("table_name")
  recordIndex Int    @map("record_index")

  details Json @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@index([tableName])
  @@map("search_index_entries")
}

// ─────────────────────────────────────────────────────────────────────────
// Windows Defender quarantine — Entries (detection metadata, RC4-decrypted
// TLV) and ResourceData (the quarantined file's own decrypted bytes), see
// defender-quarantine-engine.ts/defender-quarantine-parse.py. These are
// uploaded as two independent file roles (quarantine_entry/
// quarantine_resource) — there's no verified filename/ID convention
// linking a specific Entries resource record to a specific ResourceData
// file, so `resources` stays a JSON blob rather than a fabricated FK.
// ─────────────────────────────────────────────────────────────────────────
model DefenderQuarantineEntry {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  sourceFileName String  @map("source_file_name") @db.Text
  entryIdHex     String? @map("entry_id_hex")
  scanIdHex      String? @map("scan_id_hex")
  threatId       String? @map("threat_id")
  detectionName  String? @map("detection_name")
  timestamp      DateTime?

  resources Json @db.JsonB // [{detectionPath, detectionType, creationTime, lastAccessTime, lastWriteTime, physicalPath, flags, unknownFields}]
  rawFields Json @db.JsonB @map("raw_fields") // every decoded TLV field, including unrecognized IDs — nothing dropped

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@map("defender_quarantine_entries")
}

model DefenderQuarantinePayload {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  sourceFileName     String  @map("source_file_name") @db.Text
  magicValid         Boolean @map("magic_valid") // did the RC4-decrypted 0x0BAD00 header magic check pass
  sha256             String?
  decryptedSizeBytes BigInt? @map("decrypted_size_bytes")
  decryptedStoragePath String? @map("decrypted_storage_path") // where the decrypted payload was written — see the new download route
  fileTypeSniff      String? @map("file_type_sniff") // e.g. "PE32", "text", "unknown" — simple magic-byte sniff, not a full file-type library

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@index([sha256])
  @@map("defender_quarantine_payloads")
}

// ─────────────────────────────────────────────────────────────────────────
// BITS job database (qmgr0.dat/qmgr1.dat, legacy format only — see
// windows-artifacts plan's Decisions for why the newer ESE-based qmgr.db
// is out of scope) — see bits-engine.ts/bits-parse.py, which wraps the
// MIT-licensed bits_parser library. One row per (job, file-transfer) pair;
// isCarved marks a job recovered via carving rather than clean parsing
// (e.g. a deleted job record) — forensically notable on its own, see the
// "Recovered BITS Job Evidence" built-in rule.
// ─────────────────────────────────────────────────────────────────────────
model BitsJobEntry {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  jobId    String? @map("job_id")
  name     String? @db.Text
  desc     String? @db.Text
  cmd      String? @db.Text
  sid      String?
  jobType  String? @map("job_type")
  priority String?
  state    String?

  ctime DateTime?
  mtime DateTime?

  destFn             String? @map("dest_fn") @db.Text
  srcFn              String? @map("src_fn") @db.Text
  tmpFn              String? @map("tmp_fn") @db.Text
  downloadSizeBytes  BigInt? @map("download_size_bytes")
  transferSizeBytes  BigInt? @map("transfer_size_bytes")

  isCarved Boolean @default(false) @map("is_carved")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@index([jobId])
  @@map("bits_job_entries")
}

// ─────────────────────────────────────────────────────────────────────────
// Windows Timeline (ActivitiesCache.db, one per user profile) — see
// timeline-engine.ts/timeline-parse.py. Column facts sourced from Plaso's
// own windows_timeline.py SQLite plugin (Apache-2.0, used here as a
// documented-facts reference, not vendored code): StartTime is a Unix
// epoch integer despite the column being declared DATETIME; Payload is a
// UTF-8 JSON blob whose keys differ by activityKind; AppId/PackageName
// resolve a "generic" row's application identity. Unlike Search/
// Notifications, this has a genuinely reliable structured `path`-style
// field, so it IS fed into the rule engine (see rule-engine.ts).
// ─────────────────────────────────────────────────────────────────────────
model TimelineActivityEntry {
  id     String              @id @default(uuid()) @db.Uuid
  fileId String              @map("file_id") @db.Uuid
  file   WindowsArtifactFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  profileName String? @map("profile_name")

  startTime  DateTime? @map("start_time")
  activityKind String  @map("activity_kind") // generic | user_engaged

  appDisplayName     String? @map("app_display_name") @db.Text
  description        String? @db.Text
  packageIdentifier  String? @map("package_identifier") @db.Text
  activeDurationSeconds Int? @map("active_duration_seconds")
  reportingApp       String? @map("reporting_app")

  details Json @db.JsonB // full Payload JSON + AppId array, verbatim

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fileId])
  @@map("timeline_activity_entries")
}
